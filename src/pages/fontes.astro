---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../components/Layout.astro";
import QualityChartCard from "../components/mortality/QualityChartCard.astro";
import YearControl from "../components/mortality/YearControl.astro";
---

<Layout
  title="Fontes e metodologia — Causa Mortis"
  description="De onde vêm os números do painel: fontes oficiais (SIM/DATASUS, IBGE, RIPSA), conferências realizadas e notas metodológicas."
>
  <Header />

  <main class="center-col gap-4">
    <div class="app-content-col">
      <div class="flex flex-col gap-2 px-4 py-6">
        <h1 class="text-2xl font-bold">De onde vêm os números</h1>

        <p class="max-w-180">
          Todo valor foi calculado a partir de microdados públicos e conferido
          contra as fichas de qualificação da RIPSA. Nada foi estimado,
          interpolado ou suavizado.
        </p>
      </div>
    </div>

    <div id="app-fontes" class="center w-full bg-primary-600">
      <section class="app-content-col gap-6 px-4 py-8 text-white">
        <div class="w-full gap-4">
          <div
            class="flex flex-col gap-3 rounded-2xl border border-white/20 bg-white/10 p-6"
          >
            <h2 class="font-bold">Fontes</h2>
            <ul class="flex list-disc flex-col gap-2 pl-4 text-primary-50">
              <li>
                <strong class="text-white">Óbitos:</strong> SIM, microdados do Portal
                de Dados Abertos do SUS, integridade de cada arquivo anual verificada
                por SHA-256.
              </li>
              <li>
                <strong class="text-white">População:</strong> IBGE, projeções revisão
                2024.
              </li>
              <li>
                <strong class="text-white">Cobertura do SIM:</strong> indicador DEM.4.02
                da RIPSA.
              </li>
              <li>
                <strong class="text-white">Padronização:</strong> NT nº 51/2025-CGIAE
                — direta, 18 faixas, população-padrão Brasil 2022.
              </li>
              <li>
                <strong class="text-white">Causas:</strong> fichas MRT.3.01, MRT.4.01–04,
                MRT.5.02 e MRT.5.04.
              </li>
            </ul>
          </div>
        </div>
      </section>
    </div>

    <div class="app-content-col">
      <div
        class="flex flex-col gap-3 rounded-2xl border border-white/20 bg-white/10 p-6"
      >
        <h2 class="font-bold">Conferências e limitações</h2>
        <ul class="flex list-disc flex-col gap-2 pl-4">
          <li>
            Neoplasias malignas 2023: 249.942 — idêntico à ficha MRT.5.02.
          </li>
          <li>
            Causas externas por tipo e meios da agressão: totais idênticos às
            fichas MRT.4.01–04.
          </li>
          <li>
            Escopo temporal 2000 em diante: as projeções do IBGE, denominador
            das taxas, começam nesse ano.
          </li>
          <li>
            2025 é preliminar (Portaria MS nº 116/2009); 2024 já foi
            consolidado. A cobertura do SIM é publicada até 2023, então os dois
            últimos anos seguem sem verificação independente de sub-registro.
          </li>
          <li>
            Sub-registro declarado, não corrigido. Segundo nível de causa
            disponível onde a RIPSA o normatiza: neoplasias, cardiovasculares e
            causas externas.
          </li>
        </ul>
      </div>

      <div class="app-content-col flex flex-col gap-4 px-4 pb-8">
        <YearControl />
        <QualityChartCard active standalone padding="p-6" />
      </div>
    </div>

    <script>
      import { fetchCoverage } from "../lib/mortality/data";
      import { fetchDimensions } from "../lib/mortality/dimensions";
      import { FiltersStore } from "../lib/mortality/filters";

      const container = document.getElementById("chart-quality");

      async function mountQualityChart(chartMount: HTMLElement): Promise<void> {
        const [dimensions, coverageTable, quality, main] = await Promise.all([
          fetchDimensions(),
          fetchCoverage(),
          import("../lib/mortality/charts/quality"),
          import("../lib/mortality/main"),
        ]);
        const store = new FiltersStore({
          location: "BR",
          sex: "Ambos",
          year: quality.findLatestCoverageYear(dimensions, coverageTable),
          causeGroup: null,
          detailedSubgroup: null,
          externalCauseType: null,
          assaultMeans: null,
          pyramidMeasure: "rate",
        });

        const playback = main.createYearPlayback(dimensions, store);
        main.setupYearControl(document, dimensions, store, playback, "");

        chartMount.querySelector(".chart-placeholder")?.remove();
        quality.init(chartMount, store, dimensions);
      }

      if (container instanceof HTMLElement) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              observer.disconnect();
              void mountQualityChart(container);
            }
          },
          { rootMargin: "200px" },
        );
        observer.observe(container);
      }
    </script>
  </main>

  <Footer />
</Layout>
