---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../components/Layout.astro";
import MortalityExplorer from "../components/mortality/MortalityExplorer.astro";
---

<Layout>
  <Header />

  <main class="center-col gap-4">
    <section id="app-charts" class="app-content-col gap-6 px-4 py-6">
      <div class="flex flex-col gap-2">
        <h2 class="text-2xl font-bold">Explore os dados</h2>
        <p>
          Filtre por território, sexo, ano e causa para ver como a mortalidade
          no Brasil muda em cada recorte.
        </p>
      </div>

      <MortalityExplorer />
    </section>

    <div
      id="app-sobre"
      class="center w-full border border-gray-200 bg-primary-50"
    >
      <section class="app-content-col gap-4 px-4 py-12 sm:py-16">
        <h3 class="text-2xl font-bold text-gray-800">Sobre o painel</h3>

        <p class="text-gray-800">
          Este painel tem finalidade <strong>didática e de divulgação</strong>.
          Para análise técnica e formulação de política pública, recomenda-se a
          extração dos dados diretamente no DataSUS (SIM e projeções
          populacionais do IBGE), onde estão disponíveis os microdados
          completos, as revisões posteriores e as notas técnicas de cada base.
        </p>
      </section>
    </div>
  </main>

  <Footer />
</Layout>
