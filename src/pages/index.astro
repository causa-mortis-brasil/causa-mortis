---
import Layout from "../components/Layout.astro";
import MortalityExplorer from "../components/mortality/MortalityExplorer.astro";
import Pattern from "../components/Pattern.astro";
---

<Layout>
  <div class="center p-4">
    <header class="app-content justify-between items-center">
      <div data-name="logo" class="flex gap-3 items-center">
        <img src="/logo.svg" alt="" class="w-12" />
        <div class="text-lg flex flex-col gap-0 *:leading-none">
          <span>Causa</span>
          <span class="font-bold">Mortis</span>
        </div>
      </div>

      <nav aria-label="Navegação principal">
        <ul class="flex gap-4">
          <li><a href="#">O que é?</a></li>
          <li><a href="#app-charts">Explorar dados</a></li>
          <li><a href="#">Fontes</a></li>
        </ul>
      </nav>
    </header>
  </div>

  <main class="center-col gap-4">
    <div class="center w-full bg-primary-50 border border-gray-200">
      <section class="app-content-col center-col gap-6 text-center py-20 px-4">
        <span
          class="text-primary-500 font-medium bg-primary-100 rounded-full text-sm px-3 py-1"
        >
          SIM/DATASUS · IBGE · 2000–2025
        </span>

        <h1 class="text-5xl font-extrabold max-w-140 text-gray-800">
          A forma como os brasileiros morrem
        </h1>

        <p class="text-lg max-w-140 text-gray-600">
          Lorem ipsum dolor sit amet consectetur adipisicing elit. Reunimos os
          registros oficiais de óbitos do Brasil por causa, idade, sexo e
          região.
        </p>

        <div class="flex gap-2">
          <a
            href="#app-charts"
            class="bg-primary-500 hover:bg-primary-600 transition-colors duration-200 rounded-full flex items-center justify-center px-8 min-h-12 text-white font-medium"
          >
            Explorar dados
          </a>

          <a
            href="#"
            class="bg-white hover:bg-gray-50 transition-colors duration-200 border border-gray-200 rounded-full flex items-center justify-center px-8 min-h-12 font-medium"
          >
            Fontes
          </a>
        </div>
      </section>
    </div>

    <section id="app-charts" class="app-content-col py-6 gap-2">
      <h2 class="text-2xl font-bold">Explore os dados</h2>
      <p class="text-gray-600 mb-4">
        Filtre por território, sexo, ano e causa para ver como a mortalidade no
        Brasil muda em cada recorte.
      </p>
      <MortalityExplorer />
    </section>

    <section class="w-full flex overflow-hidden">
      <div class="flex flex-wrap min-w-2000 max-w-2000 w-2000 gap-1">
        {
          Array.from({ length: 400 }).map(() => {
            const rotations = [
              "rotate-0",
              "rotate-90",
              "rotate-180",
              "rotate-270",
            ];
            const randomClass = rotations[Math.floor(Math.random() * 4)];

            return <Pattern class={`w-20 h-20 ${randomClass}`} />;
          })
        }
      </div>
    </section>
  </main>
</Layout>
