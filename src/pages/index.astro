---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../components/Layout.astro";
import MortalityExplorer from "../components/mortality/MortalityExplorer.astro";
---

<Layout>
  <Header />

  <main class="center-col gap-4">
    <section id="app-charts" class="app-content-col app-gutter gap-6 py-6">
      <h1 class="sr-only">Mortalidade no Brasil, causa por causa</h1>

      <MortalityExplorer />
    </section>

    <div
      id="app-sobre"
      class="center w-full border-t border-gray-200 bg-primary-50 dark:border-gray-800 dark:bg-gray-800"
    >
      <section class="app-content-col app-gutter gap-4 py-12 sm:py-16">
        <p class="text-gray-700 dark:text-gray-300">
          Para análise técnica e formulação de política pública, recomenda-se a
          extração dos dados diretamente no DataSUS (SIM e projeções
          populacionais do IBGE), onde estão disponíveis os microdados
          completos, as revisões posteriores e as notas técnicas de cada base.
        </p>
      </section>
    </div>
  </main>

  <Footer />
</Layout>
