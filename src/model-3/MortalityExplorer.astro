---
import {
  Blocks,
  ChartColumnStacked,
  ChartLine,
  Map,
  Pause,
  Play,
  Pyramid,
} from "@lucide/astro";
import ChartCard from "../components/mortality/ChartCard.astro";
import SummaryStat from "./SummaryStat.astro";

const charts = [
  { name: "map", label: "Mapa", icon: Map },
  { name: "evolution", label: "Evolução", icon: ChartLine },
  { name: "causes", label: "Causas", icon: Blocks },
  {
    name: "age-composition",
    label: "Composição",
    icon: ChartColumnStacked,
  },
  { name: "pyramid", label: "Sexo", icon: Pyramid },
];
---

<section id="mortality-explorer" class="app-content-col gap-4 relative">
  <div
    id="filters-sentinel"
    aria-hidden="true"
    class="absolute inset-x-0 top-0 h-px"
  >
  </div>
  <div
    id="filters-panel"
    class="group sticky z-10 w-full bg-white border border-gray-200 rounded-2xl transition-[border-radius,border-width] duration-200 data-[stuck]:rounded-none data-[stuck]:border-t-0 data-[stuck]:border-x-0 data-[stuck]:w-screen data-[stuck]:ml-[calc(50%-50vw)]"
  >
    <div class="center w-full">
      <div
        class="app-content flex-col gap-4 p-4 transition-[padding] duration-200 group-data-[stuck]:py-2"
      >
        <div
          id="filters-row"
          class="w-full flex flex-wrap gap-4 items-end group-data-[stuck]:flex-nowrap group-data-[stuck]:items-center"
        >
          <div
            class="w-full sm:w-auto flex flex-col gap-1 group-data-[stuck]:w-auto"
          >
            <label
              for="filter-location"
              class="text-sm font-medium text-gray-600 group-data-[stuck]:sr-only"
              >Território</label
            >
            <select
              id="filter-location"
              class="w-full h-10 border border-gray-200 rounded-2xl px-3 sm:min-w-40 cursor-pointer"
            ></select>
          </div>

          <fieldset
            class="w-full sm:w-auto flex flex-col gap-1 group-data-[stuck]:w-auto"
          >
            <legend
              class="text-sm font-medium text-gray-600 group-data-[stuck]:sr-only"
              >Sexo</legend
            >
            <div
              id="filter-sex"
              class="flex gap-1 bg-white border border-gray-200 rounded-2xl h-10 p-1"
              role="radiogroup"
              aria-label="Sexo"
            >
            </div>
          </fieldset>

          <div
            class="w-full sm:w-auto flex flex-col gap-1 group-data-[stuck]:w-auto"
          >
            <label
              for="filter-cause-group"
              class="text-sm font-medium text-gray-600 group-data-[stuck]:sr-only"
              >Grupo de causas</label
            >
            <select
              id="filter-cause-group"
              class="w-full h-10 border border-gray-200 rounded-2xl px-3 sm:min-w-48 cursor-pointer"
            ></select>
          </div>

          <div
            id="filter-detail-wrap"
            hidden
            class="w-full sm:w-auto flex flex-col gap-1 group-data-[stuck]:w-auto"
          >
            <label
              id="filter-detail-label"
              for="filter-detail"
              class="text-sm font-medium text-gray-600 group-data-[stuck]:sr-only"
              >Detalhe</label
            >
            <select
              id="filter-detail"
              class="w-full h-10 border border-gray-200 rounded-2xl px-3 sm:min-w-48 cursor-pointer"
            ></select>
          </div>

          <div
            id="filter-external-wrap"
            hidden
            class="w-full sm:w-auto flex flex-col gap-1 group-data-[stuck]:w-auto"
          >
            <label
              for="filter-external"
              class="text-sm font-medium text-gray-600 group-data-[stuck]:sr-only"
              >Tipo de causa externa</label
            >
            <select
              id="filter-external"
              class="w-full h-10 border border-gray-200 rounded-2xl px-3 sm:min-w-48 cursor-pointer"
            ></select>
          </div>

          <div
            id="filter-assault-wrap"
            hidden
            class="w-full sm:w-auto flex flex-col gap-1 group-data-[stuck]:w-auto"
          >
            <label
              for="filter-assault"
              class="text-sm font-medium text-gray-600 group-data-[stuck]:sr-only"
              >Meio utilizado</label
            >
            <select
              id="filter-assault"
              class="w-full h-10 border border-gray-200 rounded-2xl px-3 sm:min-w-48 cursor-pointer"
            ></select>
          </div>

          <div
            id="filter-year-wrap"
            class="w-full sm:min-w-72 sm:flex-1 flex flex-col gap-1 group-data-[stuck]:w-auto"
          >
            <label
              for="filter-year"
              class="text-sm font-medium text-gray-600 group-data-[stuck]:sr-only"
            >
              Ano ·
              <output id="filter-year-value" for="filter-year">2025</output>

              <span> </span><span
                id="filter-year-preliminary"
                hidden
                class="text-primary-500"
              >
                (preliminar)</span
              >
            </label>
            <div class="h-10 flex items-center gap-3">
              <button
                type="button"
                id="filter-year-toggle"
                aria-pressed="false"
                aria-label="Reproduzir evolução dos anos"
                class="shrink-0 size-10 grid place-items-center rounded-2xl border border-gray-200 text-gray-600 hover:bg-gray-100 cursor-pointer transition-colors"
              >
                <span id="filter-year-icon-play"><Play class="size-4" /></span>
                <span id="filter-year-icon-pause" hidden
                  ><Pause class="size-4" /></span
                >
              </button>
              <input
                type="range"
                id="filter-year"
                class="w-full accent-primary-500"
              />
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="center w-full border-t border-gray-100">
      <div
        class="app-content px-4 py-3 transition-[padding] duration-200 group-data-[stuck]:py-2"
      >
        <div
          class="w-full grid grid-cols-2 gap-2 group-data-[stuck]:flex group-data-[stuck]:flex-nowrap group-data-[stuck]:items-center group-data-[stuck]:gap-6"
        >
          <SummaryStat label="Óbitos registrados" valueId="stat-deaths-value" />
          <SummaryStat
            label="Taxa padronizada"
            valueId="stat-std-rate-value"
            subtitleId="stat-std-rate-delta"
          />
          <SummaryStat
            label="Taxa bruta"
            valueId="stat-crude-rate-value"
            subtitleId="stat-crude-rate-delta"
          />
          <SummaryStat
            label="Cobertura do SIM"
            valueId="stat-coverage-value"
            subtitleId="stat-coverage-subtitle"
          />
        </div>
      </div>
    </div>
  </div>

  <div class="flex flex-col md:flex-row gap-4 items-start">
    <nav
      aria-label="Selecionar gráfico"
      role="tablist"
      aria-orientation="vertical"
      class="flex flex-row md:flex-col flex-wrap gap-1 md:w-42 md:shrink-0"
    >
      {
        charts.map(({ name, label, icon: Icon }) => (
          <button
            type="button"
            id={`tab-${name}`}
            role="tab"
            data-chart-tab={name}
            aria-selected={name === "map"}
            aria-controls={`panel-${name}`}
            class="chart-tab-button"
          >
            <Icon class="size-4 shrink-0" />
            {label}
          </button>
        ))
      }
    </nav>

    <div
      data-chart-panels
      class="min-w-0 grow flex flex-col gap-4 transition-[height] duration-300 ease-in-out motion-reduce:transition-none"
    >
      <ChartCard
        title="Onde se morre mais"
        chartId="chart-map"
        chartName="map"
        height="h-96 md:h-120"
        active
      >
        <div slot="controls" class="flex flex-wrap items-center gap-3 sm:gap-4">
          <label class="flex items-center gap-2 text-sm text-gray-600">
            <input
              type="checkbox"
              id="map-scale-stable"
              checked
              class="accent-primary-500"
            />
            Escala estável
          </label>
          <div
            id="map-scale-type"
            class="flex gap-1 bg-white border border-gray-200 rounded-2xl h-10 p-1"
            role="radiogroup"
            aria-label="Escala do mapa"
          >
          </div>
        </div>
      </ChartCard>

      <ChartCard
        title="Evolução das taxas"
        chartId="chart-evolution"
        chartName="evolution"
        height="h-64 md:h-80"
      />

      <ChartCard
        title="Do que se morre"
        chartId="chart-causes"
        chartName="causes"
        height="h-96 md:h-120 md:max-w-2xl md:mx-auto"
      />

      <ChartCard
        title="Do que se morre em cada idade"
        chartId="chart-age-composition"
        chartName="age-composition"
        height="h-108 md:h-128"
      >
        <p
          slot="notice"
          id="age-composition-warning"
          hidden
          class="text-sm text-primary-500 bg-primary-50 rounded-2xl px-3 py-2"
        >
          Esta visão respeita apenas o filtro de grupo de causas — o detalhe
          selecionado é ignorado, pois um subgrupo não particiona o total da
          faixa etária.
        </p>
      </ChartCard>

      <ChartCard
        title="Pirâmide de mortalidade"
        chartId="chart-pyramid"
        chartName="pyramid"
        height="h-96 md:h-120"
      >
        <select
          slot="controls"
          id="pyramid-measure"
          aria-label="Medida"
          class="border border-gray-200 rounded-2xl px-2 py-1 text-sm cursor-pointer"
        >
          <option value="deaths">Óbitos</option>
          <option value="rate" selected>Taxa por faixa</option>
          <option value="contribution"
            >Contribuição para a taxa padronizada</option
          >
        </select>
      </ChartCard>
    </div>
  </div>
</section>

<script>
  import { mountMortalityExplorer } from "../lib/mortality/main.ts";

  const explorer = document.getElementById("mortality-explorer");
  if (explorer) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          observer.disconnect();
          void mountMortalityExplorer(explorer);
        }
      },
      { rootMargin: "200px" },
    );
    observer.observe(explorer);
  }
</script>

<script>
  const filtersPanel = document.getElementById("filters-panel");
  const filtersSentinel = document.getElementById("filters-sentinel");
  const miniHeader = document.getElementById("app-header-mini");

  if (filtersPanel && filtersSentinel && miniHeader) {
    const offset = miniHeader.offsetHeight;
    filtersPanel.style.top = `${offset}px`;

    const observer = new IntersectionObserver(
      ([entry]) => {
        filtersPanel.toggleAttribute("data-stuck", !entry.isIntersecting);
      },
      { rootMargin: `-${offset}px 0px 0px 0px`, threshold: 0 },
    );
    observer.observe(filtersSentinel);
  }
</script>
