---
import { Font } from "astro:assets";
import "../styles/global.css";
import Loader from "./Loader.astro";

interface Props {
  title?: string;
  description?: string;
}

const defaultDescription =
  "Infográficos interativos sobre mortalidade no Brasil com dados oficiais do SIM/DATASUS e do IBGE: evolução de taxas, causas de morte, distribuição geográfica e pirâmide de mortalidade por sexo e idade.";

const { title = "Causa Mortis", description = defaultDescription } =
  Astro.props;

const socialImage = new URL("/logo.svg", Astro.site);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<html lang="pt-BR" data-theme="light" class="scroll-pt-14 scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      const storedTheme = localStorage.getItem("theme");
      document.documentElement.dataset.theme =
        storedTheme === "light" || storedTheme === "dark"
          ? storedTheme
          : window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#013e9a" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Causa Mortis" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <Font cssVariable="--font-sora" preload />
  </head>

  <body
    class="relative flex w-full flex-col overflow-x-hidden bg-white text-gray-900 dark:bg-gray-950 dark:text-gray-100"
  >
    <Loader />

    <slot />
  </body>
</html>
