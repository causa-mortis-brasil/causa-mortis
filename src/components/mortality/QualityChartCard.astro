---
import ChartCard from "./ChartCard.astro";
import QualityScaleToggle from "./QualityScaleToggle.astro";

interface Props {
  active?: boolean;
  standalone?: boolean;
  padding?: string;
}

const { active = false, standalone = false, padding } = Astro.props;
---

<ChartCard
  title="Cobertura do SIM"
  chartId="chart-quality"
  chartName="quality"
  height="h-96 md:h-120"
  active={active}
  standalone={standalone}
  padding={padding}
  fullscreenToggle
>
  <div slot="controls" class="flex flex-wrap items-center gap-3 sm:gap-4">
    <QualityScaleToggle />
  </div>
</ChartCard>
