---
import {
  ChevronDown,
  Download,
  FileSpreadsheet,
  FileText,
  Image,
} from "@lucide/astro";

interface Props {
  title: string;
  description?: string;
  chartId: string;
  chartName: string;
  height: string;
  active?: boolean;
}

const {
  title,
  description,
  chartId,
  chartName,
  height,
  active = false,
} = Astro.props;
---

<article
  id={`panel-${chartName}`}
  class="chart-card flex flex-col gap-4 rounded-2xl border border-gray-200 bg-white p-4"
  data-chart-panel={chartName}
  role="tabpanel"
  aria-labelledby={`tab-${chartName}`}
  hidden={!active}
>
  <div
    class="flex flex-col justify-between gap-3 sm:flex-row sm:flex-wrap sm:items-start sm:gap-4"
  >
    <div class="flex flex-col gap-1">
      <h3 data-chart-title class="text-lg font-bold">{title}</h3>
      <p
        data-chart-context
        class="text-sm font-medium text-primary-600 empty:hidden"
      >
      </p>
      {
        description ? (
          <p data-chart-description class="text-sm text-gray-600">
            {description}
          </p>
        ) : (
          ""
        )
      }
    </div>
    <div class="sm:text-nowrap">
      <slot name="controls" />
    </div>
  </div>
  <slot name="notice" />
  <div
    id={chartId}
    class={`relative w-full landscape:max-h-[70vh] ${height}`}
    data-chart={chartName}
  >
    <p
      class="chart-placeholder absolute inset-0 flex items-center justify-center text-sm text-gray-400"
    >
      Carregando gráfico…
    </p>
  </div>

  <div
    class="flex flex-wrap items-end justify-between gap-3 border-t border-gray-100 pt-2 text-xs text-gray-500"
  >
    <div class="flex flex-col gap-0.5">
      <span>Fonte: SIM/DATASUS · IBGE</span>
      <a href="#app-fontes" class="text-primary-600 hover:underline">
        Notas técnicas e metodologia
      </a>
    </div>

    <div class="flex items-center gap-3">
      <span>Causa Mortis</span>

      <details data-chart-export class="group relative">
        <summary class="chart-export-trigger">
          <Download class="size-4" />
          Exportar
          <ChevronDown
            class="size-3.5 transition-transform group-open:rotate-180"
          />
        </summary>
        <div class="chart-export-menu">
          <button
            type="button"
            data-export-format="png"
            class="chart-export-item"
          >
            <Image class="size-4" />
            Imagem (PNG)
          </button>
          <button
            type="button"
            data-export-format="csv"
            class="chart-export-item"
          >
            <FileText class="size-4" />
            Dados (CSV)
          </button>
          <button
            type="button"
            data-export-format="xlsx"
            class="chart-export-item"
          >
            <FileSpreadsheet class="size-4" />
            Dados (XLSX)
          </button>
        </div>
      </details>
    </div>
  </div>
</article>
