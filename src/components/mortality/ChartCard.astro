---
interface Props {
  title: string;
  description: string;
  chartId: string;
  chartName: string;
  height: string;
  active?: boolean;
}

const {
  title,
  description,
  chartId,
  chartName,
  height,
  active = false,
} = Astro.props;
---

<article
  id={`panel-${chartName}`}
  class="chart-card bg-white border border-gray-200 rounded-2xl p-4 flex flex-col gap-2"
  data-chart-panel={chartName}
  role="tabpanel"
  aria-labelledby={`tab-${chartName}`}
  hidden={!active}
>
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h3 class="font-bold text-lg">{title}</h3>
    <slot name="controls" />
  </div>
  <p class="text-sm text-gray-600">{description}</p>
  <slot name="notice" />
  <div id={chartId} class={`relative w-full ${height}`} data-chart={chartName}>
    <p
      class="chart-placeholder absolute inset-0 flex items-center justify-center text-gray-400 text-sm"
    >
      Carregando gráfico…
    </p>
  </div>
</article>
