---
import {
  Check,
  Download,
  FileSpreadsheet,
  FileText,
  Image,
  Maximize2,
  Minimize2,
  Share2,
} from "@lucide/astro";

interface Props {
  title: string;
  description?: string;
  chartId: string;
  chartName: string;
  height: string;
  active?: boolean;
  fullscreenToggle?: boolean;
}

const {
  title,
  description,
  chartId,
  chartName,
  height,
  active = false,
  fullscreenToggle = false,
} = Astro.props;
---

<div
  id={`panel-${chartName}`}
  class="chart-card flex flex-col gap-4 rounded-2xl border border-gray-200 bg-white p-4"
  data-chart-panel={chartName}
  role="tabpanel"
  aria-labelledby={`tab-${chartName}`}
  hidden={!active}
>
  <div class="flex flex-col items-center gap-3">
    <div class="flex flex-col items-center gap-1 text-center">
      <h3 data-chart-title class="text-lg font-bold uppercase">{title}</h3>
      <p
        data-chart-subtitle
        class="text-sm font-medium text-primary-600 empty:hidden"
      >
      </p>
      {
        description ? (
          <p data-chart-description class="text-sm text-gray-600">
            {description}
          </p>
        ) : (
          ""
        )
      }
    </div>
    {
      Astro.slots.has("controls") && (
        <div class="flex flex-wrap items-center justify-end gap-3 self-end sm:text-nowrap">
          <slot name="controls" />
        </div>
      )
    }
  </div>
  <div
    id={chartId}
    class={`relative w-full landscape:max-h-[70vh] ${height}`}
    data-chart={chartName}
  >
    <p
      class="chart-placeholder absolute inset-0 flex items-center justify-center text-sm text-gray-800"
    >
      Carregando gráfico…
    </p>
  </div>

  <div
    class="flex flex-wrap items-end justify-between gap-3 border-t border-gray-100 pt-2 text-xs text-gray-500"
  >
    <div class="flex flex-col gap-0.5">
      <span>Fonte: SIM/DATASUS · IBGE</span>
      <a href="/fontes" class="text-primary-600 hover:underline">
        Notas técnicas e metodologia
      </a>
    </div>

    <div class="flex items-center gap-3">
      <details data-chart-export class="group relative">
        <summary class="chart-export-trigger">
          <Download class="size-4" />
          Exportar
        </summary>
        <div class="chart-export-menu">
          <button
            type="button"
            data-export-format="png"
            class="chart-export-item"
          >
            <Image class="size-4" />
            Imagem (PNG)
          </button>
          <button
            type="button"
            data-export-format="csv"
            class="chart-export-item"
          >
            <FileText class="size-4" />
            Dados (CSV)
          </button>
          <button
            type="button"
            data-export-format="xlsx"
            class="chart-export-item"
          >
            <FileSpreadsheet class="size-4" />
            Dados (XLSX)
          </button>
        </div>
      </details>

      <button
        type="button"
        data-chart-share
        class="chart-export-trigger shrink-0"
      >
        <span data-chart-share-icon-default>
          <Share2 class="size-4" />
        </span>
        <span data-chart-share-icon-success hidden>
          <Check class="size-4" />
        </span>
        <span data-chart-share-label>Compartilhar</span>
      </button>

      {
        fullscreenToggle && (
          <button
            type="button"
            data-chart-fullscreen-toggle
            aria-pressed="false"
            aria-label="Ver em tela cheia"
            class="chart-export-trigger shrink-0"
          >
            <span data-icon-enter>
              <Maximize2 class="size-4" />
            </span>
            <span data-icon-exit hidden>
              <Minimize2 class="size-4" />
            </span>
          </button>
        )
      }
    </div>
  </div>
</div>
