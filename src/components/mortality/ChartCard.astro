---
import {
  ChevronDown,
  Download,
  FileSpreadsheet,
  FileText,
  Image,
} from "@lucide/astro";

interface Props {
  title: string;
  description: string;
  chartId: string;
  chartName: string;
  height: string;
  active?: boolean;
}

const {
  title,
  description,
  chartId,
  chartName,
  height,
  active = false,
} = Astro.props;
---

<article
  id={`panel-${chartName}`}
  class="chart-card bg-white border border-gray-200 rounded-2xl p-4 flex flex-col gap-4"
  data-chart-panel={chartName}
  role="tabpanel"
  aria-labelledby={`tab-${chartName}`}
  hidden={!active}
>
  <div class="flex flex-wrap items-start justify-between gap-2">
    <div class="flex gap-4">
      <div class="flex flex-col gap-1">
        <h3 data-chart-title class="font-bold text-lg">{title}</h3>
        <p data-chart-description class="text-sm text-gray-600">
          {description}
        </p>
      </div>
      <div class="text-nowrap">
        <slot name="controls" />
      </div>
    </div>

    <details data-chart-export class="group relative shrink-0">
      <summary class="chart-export-trigger">
        <Download class="size-4" />
        Exportar
        <ChevronDown
          class="size-3.5 transition-transform group-open:rotate-180"
        />
      </summary>
      <div class="chart-export-menu">
        <button
          type="button"
          data-export-format="png"
          class="chart-export-item"
        >
          <Image class="size-4" />
          Imagem (PNG)
        </button>
        <button
          type="button"
          data-export-format="csv"
          class="chart-export-item"
        >
          <FileText class="size-4" />
          Dados (CSV)
        </button>
        <button
          type="button"
          data-export-format="xlsx"
          class="chart-export-item"
        >
          <FileSpreadsheet class="size-4" />
          Dados (XLSX)
        </button>
      </div>
    </details>
  </div>
  <slot name="notice" />
  <div id={chartId} class={`relative w-full ${height}`} data-chart={chartName}>
    <p
      class="chart-placeholder absolute inset-0 flex items-center justify-center text-gray-400 text-sm"
    >
      Carregando gráfico…
    </p>
  </div>
</article>
