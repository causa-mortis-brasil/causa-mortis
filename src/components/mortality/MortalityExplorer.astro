---
import {
  Blocks,
  ChartColumnStacked,
  ChartLine,
  Map,
  Pause,
  Play,
  Pyramid,
} from "@lucide/astro";
import ChartCard from "./ChartCard.astro";
import SummaryStat from "./SummaryStat.astro";

const charts = [
  { name: "map", label: "Mapa", icon: Map },
  { name: "evolution", label: "Evolução", icon: ChartLine },
  { name: "causes", label: "Causas", icon: Blocks },
  {
    name: "age-composition",
    label: "Composição",
    icon: ChartColumnStacked,
  },
  { name: "pyramid", label: "Sexo", icon: Pyramid },
];
---

<section id="mortality-explorer" class="app-content-col gap-4">
  <div
    class="w-full bg-white border border-gray-200 rounded-2xl p-4 flex flex-wrap gap-4 items-end"
  >
    <div class="w-full sm:w-auto flex flex-col gap-1">
      <label for="filter-location" class="text-sm font-medium text-gray-600"
        >Território</label
      >
      <select
        id="filter-location"
        class="w-full h-10 border border-gray-200 rounded-2xl px-3 sm:min-w-40 cursor-pointer"
      ></select>
    </div>

    <fieldset class="w-full sm:w-auto flex flex-col gap-1">
      <legend class="text-sm font-medium text-gray-600">Sexo</legend>
      <div
        id="filter-sex"
        class="flex gap-1 bg-white border border-gray-200 rounded-2xl p-2"
        role="radiogroup"
        aria-label="Sexo"
      >
      </div>
    </fieldset>

    <div class="w-full sm:w-auto flex flex-col gap-1">
      <label for="filter-cause-group" class="text-sm font-medium text-gray-600"
        >Grupo de causas</label
      >
      <select
        id="filter-cause-group"
        class="w-full h-10 border border-gray-200 rounded-2xl px-3 sm:min-w-48 cursor-pointer"
      ></select>
    </div>

    <div
      id="filter-detail-wrap"
      hidden
      class="w-full sm:w-auto flex flex-col gap-1"
    >
      <label
        id="filter-detail-label"
        for="filter-detail"
        class="text-sm font-medium text-gray-600">Detalhe</label
      >
      <select
        id="filter-detail"
        class="w-full h-10 border border-gray-200 rounded-2xl px-3 sm:min-w-48 cursor-pointer"
      ></select>
    </div>

    <div
      id="filter-external-wrap"
      hidden
      class="w-full sm:w-auto flex flex-col gap-1"
    >
      <label for="filter-external" class="text-sm font-medium text-gray-600"
        >Tipo de causa externa</label
      >
      <select
        id="filter-external"
        class="w-full h-10 border border-gray-200 rounded-2xl px-3 sm:min-w-48 cursor-pointer"
      ></select>
    </div>

    <div
      id="filter-assault-wrap"
      hidden
      class="w-full sm:w-auto flex flex-col gap-1"
    >
      <label for="filter-assault" class="text-sm font-medium text-gray-600"
        >Meio utilizado</label
      >
      <select
        id="filter-assault"
        class="w-full h-10 border border-gray-200 rounded-2xl px-3 sm:min-w-48 cursor-pointer"
      ></select>
    </div>

    <div
      id="filter-year-wrap"
      class="w-full sm:w-auto sm:grow sm:min-w-50 flex flex-col gap-1"
    >
      <label for="filter-year" class="text-sm font-medium text-gray-600">
        Ano · <output id="filter-year-value" for="filter-year">2025</output>

        <span> </span><span
          id="filter-year-preliminary"
          hidden
          class="text-primary-500"
        >
          (preliminar)</span
        >
      </label>
      <div class="h-10 flex items-center gap-3">
        <button
          type="button"
          id="filter-year-toggle"
          aria-pressed="false"
          aria-label="Reproduzir evolução dos anos"
          class="shrink-0 size-10 grid place-items-center rounded-2xl border border-gray-200 text-gray-600 hover:bg-gray-100 cursor-pointer transition-colors"
        >
          <span id="filter-year-icon-play"><Play class="size-4" /></span>
          <span id="filter-year-icon-pause" hidden
            ><Pause class="size-4" /></span
          >
        </button>
        <input
          type="range"
          id="filter-year"
          class="w-full accent-primary-500"
        />
      </div>
    </div>
  </div>

  <div class="flex flex-col md:flex-row gap-4 items-start">
    <nav
      aria-label="Selecionar gráfico"
      role="tablist"
      aria-orientation="vertical"
      class="flex flex-row md:flex-col flex-wrap gap-1 md:w-64 md:shrink-0"
    >
      {
        charts.map(({ name, label, icon: Icon }) => (
          <button
            type="button"
            id={`tab-${name}`}
            role="tab"
            data-chart-tab={name}
            aria-selected={name === "map"}
            aria-controls={`panel-${name}`}
            class="chart-tab-button"
          >
            <Icon class="size-4 shrink-0" />
            {label}
          </button>
        ))
      }
    </nav>

    <div class="min-w-0 grow flex flex-col gap-4">
      <ChartCard
        title="Onde se morre mais"
        description="Lorem ipsum dolor, sit amet consectetur adipisicing elit. Optio autem voluptatibus vel quos et."
        chartId="chart-map"
        chartName="map"
        height="h-96 md:h-120"
        active
      >
        <div slot="controls" class="flex flex-wrap items-center gap-3 sm:gap-4">
          <label class="flex items-center gap-2 text-sm text-gray-600">
            <input
              type="checkbox"
              id="map-scale-stable"
              checked
              class="accent-primary-500"
            />
            Escala estável
          </label>
          <div
            id="map-scale-type"
            class="flex gap-1 bg-white border border-gray-200 rounded-2xl p-2"
            role="radiogroup"
            aria-label="Escala do mapa"
          >
          </div>
        </div>
      </ChartCard>

      <ChartCard
        title="Evolução das taxas"
        description="Lorem ipsum dolor, sit amet consectetur adipisicing elit. Optio autem voluptatibus vel quos et."
        chartId="chart-evolution"
        chartName="evolution"
        height="h-64 md:h-80"
      />

      <ChartCard
        title="Do que se morre"
        description="Lorem ipsum dolor, sit amet consectetur adipisicing elit. Optio autem voluptatibus vel quos et."
        chartId="chart-causes"
        chartName="causes"
        height="h-96 md:h-120 md:max-w-2xl md:mx-auto"
      />

      <ChartCard
        title="Do que se morre em cada idade"
        description="Lorem ipsum dolor, sit amet consectetur adipisicing elit. Optio autem voluptatibus vel quos et."
        chartId="chart-age-composition"
        chartName="age-composition"
        height="h-108 md:h-128"
      >
        <p
          slot="notice"
          id="age-composition-warning"
          hidden
          class="text-sm text-primary-500 bg-primary-50 rounded-2xl px-3 py-2"
        >
          Esta visão respeita apenas o filtro de grupo de causas — o detalhe
          selecionado é ignorado, pois um subgrupo não particiona o total da
          faixa etária.
        </p>
      </ChartCard>

      <ChartCard
        title="Pirâmide de mortalidade"
        description="Lorem ipsum dolor, sit amet consectetur adipisicing elit. Optio autem voluptatibus vel quos et."
        chartId="chart-pyramid"
        chartName="pyramid"
        height="h-96 md:h-120"
      >
        <select
          slot="controls"
          id="pyramid-measure"
          aria-label="Medida"
          class="border border-gray-200 rounded-2xl px-2 py-1 text-sm cursor-pointer"
        >
          <option value="deaths">Óbitos</option>
          <option value="rate" selected>Taxa por faixa</option>
          <option value="contribution"
            >Contribuição para a taxa padronizada</option
          >
        </select>
      </ChartCard>
    </div>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
    <SummaryStat label="Óbitos registrados" valueId="stat-deaths-value" />
    <SummaryStat
      label="Taxa padronizada"
      valueId="stat-std-rate-value"
      subtitleId="stat-std-rate-delta"
    />
    <SummaryStat
      label="Taxa bruta"
      valueId="stat-crude-rate-value"
      subtitleId="stat-crude-rate-delta"
    />
    <SummaryStat
      label="Cobertura do SIM"
      valueId="stat-coverage-value"
      subtitleId="stat-coverage-subtitle"
    />
  </div>
</section>

<script>
  import { mountMortalityExplorer } from "../../lib/mortality/main.ts";

  const explorer = document.getElementById("mortality-explorer");
  if (explorer) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          observer.disconnect();
          void mountMortalityExplorer(explorer);
        }
      },
      { rootMargin: "200px" },
    );
    observer.observe(explorer);
  }
</script>
