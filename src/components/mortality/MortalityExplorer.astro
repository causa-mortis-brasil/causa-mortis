---
import {
  Blocks,
  ChartColumnStacked,
  ChartLine,
  Hash,
  Pause,
  Play,
  Pyramid,
  SlidersHorizontal,
} from "@lucide/astro";
import BrazilIcon from "../icons/BrazilIcon.astro";
import ChartCard from "./ChartCard.astro";
import CustomSelect from "./CustomSelect.astro";
import SummaryStat from "./SummaryStat.astro";

const charts = [
  { name: "map", label: "Mapa", icon: BrazilIcon },
  { name: "evolution", label: "Evolução", icon: ChartLine },
  { name: "causes", label: "Causas", icon: Blocks },
  {
    name: "age-composition",
    label: "Composição",
    icon: ChartColumnStacked,
  },
  { name: "pyramid", label: "Sexo", icon: Pyramid },
  { name: "stats", label: "Resumo", icon: Hash },
];
---

<section id="mortality-explorer" class="app-content-col gap-4">
  <div id="filters-panel" class="w-full rounded-2xl bg-primary-100">
    <div class="center w-full">
      <div
        id="filters-row"
        class="app-content flex-wrap items-center justify-between gap-x-1 gap-y-2 p-4"
      >
        <div
          class="flex w-full flex-wrap items-center gap-x-1 gap-y-2 sm:w-auto"
        >
          <CustomSelect
            id="filter-location"
            name="Território"
            class="w-full sm:w-auto"
          />
          <CustomSelect
            id="filter-cause-group"
            name="Grupo de causas"
            class="w-full sm:w-auto"
          />

          {
            [
              { id: "filter-detail", name: "Detalhe" },
              { id: "filter-external", name: "Tipo de causa externa" },
              { id: "filter-assault", name: "Meio utilizado" },
            ].map(({ id, name }) => (
              <div id={`${id}-wrap`} hidden class="w-full sm:w-auto">
                <CustomSelect id={id} name={name} class="w-full" />
              </div>
            ))
          }

          <div id="filter-sex-wrap" class="w-full sm:w-auto">
            <CustomSelect id="filter-sex" name="Sexo" class="w-full" />
          </div>
        </div>

        <div
          id="filter-year-wrap"
          class="flex h-10 w-full items-center gap-3 sm:w-72"
        >
          <button
            type="button"
            id="filter-year-toggle"
            aria-pressed="false"
            aria-label="Reproduzir evolução dos anos"
            class="grid size-10 shrink-0 cursor-pointer place-items-center rounded-2xl bg-white text-gray-600 transition-colors hover:bg-gray-50"
          >
            <span id="filter-year-icon-play"><Play class="size-4" /></span>
            <span id="filter-year-icon-pause" hidden
              ><Pause class="size-4" /></span
            >
          </button>
          <input
            type="range"
            id="filter-year"
            class="w-full accent-primary-500"
          />
          <output
            id="filter-year-value"
            for="filter-year"
            class="shrink-0 text-sm font-medium text-gray-700 tabular-nums"
            >2025</output
          >
        </div>
      </div>
    </div>
  </div>
  <div id="filters-sentinel" aria-hidden="true" class="h-px w-full -mt-4"></div>

  <div class="flex flex-col items-start gap-4 md:flex-row">
    <nav
      aria-label="Selecionar gráfico"
      role="tablist"
      aria-orientation="vertical"
      class="flex flex-row flex-wrap justify-center gap-2 md:w-auto md:shrink-0 md:flex-col md:justify-start"
    >
      {
        charts.map(({ name, label, icon: Icon }) => (
          <button
            type="button"
            id={`tab-${name}`}
            role="tab"
            data-chart-tab={name}
            aria-selected={name === "map"}
            aria-controls={`panel-${name}`}
            aria-label={label}
            title={label}
            class="p-6 aria-selected:bg-primary-50 aria-selected:text-primary-600 focus-visible:outline-primary-500 flex size-11 shrink-0 cursor-pointer items-center justify-center text-gray-600 transition-colors hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-2 rounded-2xl border border-gray-200 bg-white"
          >
            <Icon class="size-5 shrink-0" />
          </button>
        ))
      }
    </nav>

    <div
      data-chart-panels
      class="flex min-w-0 grow flex-col gap-4 transition-[height] duration-300 ease-in-out motion-reduce:transition-none"
    >
      <div
        id="panel-stats"
        class="chart-card flex flex-col gap-4 rounded-2xl border border-gray-200 bg-white p-4"
        data-chart-panel="stats"
        role="tabpanel"
        aria-labelledby="tab-stats"
        hidden
      >
        <h3 class="text-lg font-bold">Resumo</h3>
        <div class="grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-4">
          <SummaryStat label="Óbitos registrados" valueId="stat-deaths-value" />
          <SummaryStat
            label="Taxa padronizada"
            valueId="stat-std-rate-value"
            subtitleId="stat-std-rate-delta"
          />
          <SummaryStat
            label="Taxa bruta"
            valueId="stat-crude-rate-value"
            subtitleId="stat-crude-rate-delta"
          />
          <SummaryStat
            label="Cobertura do SIM"
            valueId="stat-coverage-value"
            subtitleId="stat-coverage-subtitle"
          />
        </div>
      </div>

      <ChartCard
        title="Onde se morre mais"
        chartId="chart-map"
        chartName="map"
        height="h-96 md:h-120"
        active
        fullscreenToggle
      >
        <div slot="controls" class="flex flex-wrap items-center gap-3 sm:gap-4">
          <label class="flex items-center gap-2 text-sm text-gray-600">
            <input
              type="checkbox"
              id="map-scale-stable"
              checked
              class="accent-primary-500"
            />
            Escala estável
          </label>
        </div>
      </ChartCard>

      <ChartCard
        title="Evolução das taxas"
        chartId="chart-evolution"
        chartName="evolution"
        height="h-64 md:h-80"
        fullscreenToggle
      />

      <ChartCard
        title="Do que se morre"
        chartId="chart-causes"
        chartName="causes"
        height="h-96 md:h-120 md:max-w-2xl md:mx-auto"
        fullscreenToggle
      />

      <ChartCard
        title="Do que se morre em cada idade"
        chartId="chart-age-composition"
        chartName="age-composition"
        height="h-108 md:h-128"
        fullscreenToggle
      />

      <ChartCard
        title="Pirâmide de mortalidade"
        chartId="chart-pyramid"
        chartName="pyramid"
        height="h-96 md:h-120"
        fullscreenToggle
      >
        <select
          slot="controls"
          id="pyramid-measure"
          aria-label="Medida"
          class="cursor-pointer rounded-2xl border border-gray-200 px-2 py-1 text-sm"
        >
          <option value="deaths">Óbitos absolutos</option>
          <option value="rate" selected>Taxa relativa</option>
        </select>
      </ChartCard>
    </div>
  </div>

  <script>
    import { mountMortalityExplorer } from "../../lib/mortality/main.ts";

    const explorer = document.getElementById("mortality-explorer");
    if (explorer) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            observer.disconnect();
            void mountMortalityExplorer(explorer);
          }
        },
        { rootMargin: "200px" },
      );
      observer.observe(explorer);
    }
  </script>

  <script>
    const filtersSentinel = document.getElementById("filters-sentinel");
    const filtersFloating = document.getElementById("filters-floating");
    const miniHeader = document.getElementById("app-header-mini");

    if (filtersSentinel && filtersFloating && miniHeader) {
      const offset = miniHeader.offsetHeight;

      const durationMs = 200;
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      let animationFrame: number | undefined;
      let settleTimeout: ReturnType<typeof setTimeout> | undefined;
      let visible = false;

      const hiddenY = () => -filtersFloating.getBoundingClientRect().height;

      const settle = (isVisible: boolean) => {
        filtersFloating.style.transform = isVisible
          ? `translateY(${offset}px)`
          : `translateY(${hiddenY()}px)`;
      };

      const animateY = (from: number, to: number, isVisible: boolean) => {
        if (animationFrame !== undefined) cancelAnimationFrame(animationFrame);
        clearTimeout(settleTimeout);

        if (reduceMotion) {
          settle(isVisible);
          return;
        }

        const start = performance.now();
        const step = (now: number) => {
          const t = Math.min((now - start) / durationMs, 1);
          const eased = 1 - (1 - t) ** 3;
          filtersFloating.style.transform = `translateY(${from + (to - from) * eased}px)`;
          animationFrame = t < 1 ? requestAnimationFrame(step) : undefined;
        };
        animationFrame = requestAnimationFrame(step);
        settleTimeout = setTimeout(() => settle(isVisible), durationMs + 50);
      };

      settle(false);

      const observer = new IntersectionObserver(
        ([entry]) => {
          const shouldBeVisible =
            !entry.isIntersecting && entry.boundingClientRect.top < offset;
          if (shouldBeVisible === visible) return;
          visible = shouldBeVisible;

          filtersFloating.inert = !visible;
          animateY(
            visible ? hiddenY() : offset,
            visible ? offset : hiddenY(),
            visible,
          );
        },
        { rootMargin: `-${offset}px 0px 0px 0px`, threshold: 0 },
      );
      observer.observe(filtersSentinel);
    }

    const filtersPanel = document.getElementById("filters-panel");
    document
      .getElementById("filters-floating-open")
      ?.addEventListener("click", () => {
        filtersPanel?.scrollIntoView({ behavior: "smooth", block: "start" });
      });

    const yearInput = document.getElementById("filter-year");
    const yearOutput = document.getElementById("filter-year-value");
    const yearToggle = document.getElementById("filter-year-toggle");
    const floatingInput = document.getElementById("filter-year-floating");
    const floatingOutput = document.getElementById(
      "filter-year-floating-value",
    );
    const floatingToggle = document.getElementById(
      "filter-year-floating-toggle",
    );
    const floatingPlayIcon = document.getElementById(
      "filter-year-floating-icon-play",
    );
    const floatingPauseIcon = document.getElementById(
      "filter-year-floating-icon-pause",
    );

    if (
      yearInput instanceof HTMLInputElement &&
      yearOutput &&
      yearToggle instanceof HTMLButtonElement &&
      floatingInput instanceof HTMLInputElement &&
      floatingOutput &&
      floatingToggle instanceof HTMLButtonElement &&
      floatingPlayIcon &&
      floatingPauseIcon
    ) {
      const syncFromOriginal = () => {
        floatingInput.min = yearInput.min;
        floatingInput.max = yearInput.max;
        floatingInput.step = yearInput.step;
        floatingInput.value = yearInput.value;
        floatingInput.disabled = yearInput.disabled;
        floatingOutput.textContent = yearOutput.textContent;

        const playing = yearToggle.getAttribute("aria-pressed") === "true";
        floatingToggle.setAttribute("aria-pressed", String(playing));
        floatingToggle.setAttribute(
          "aria-label",
          yearToggle.getAttribute("aria-label") ?? "",
        );
        floatingPlayIcon.toggleAttribute("hidden", playing);
        floatingPauseIcon.toggleAttribute("hidden", !playing);
      };

      syncFromOriginal();
      new MutationObserver(syncFromOriginal).observe(yearOutput, {
        characterData: true,
        childList: true,
        subtree: true,
      });
      new MutationObserver(syncFromOriginal).observe(yearToggle, {
        attributes: true,
        attributeFilter: ["aria-pressed"],
      });
      new MutationObserver(syncFromOriginal).observe(yearInput, {
        attributes: true,
        attributeFilter: ["disabled"],
      });

      floatingInput.addEventListener("input", () => {
        yearInput.value = floatingInput.value;
        yearInput.dispatchEvent(new Event("input", { bubbles: true }));
      });

      floatingToggle.addEventListener("click", () => yearToggle.click());
    }
  </script>
</section>

<div
  id="filters-floating"
  inert
  class="fixed inset-x-0 top-0 z-10 border-b border-gray-200 bg-white/95 backdrop-blur-sm"
>
  <div class="center w-full">
    <div class="app-content items-center gap-3 px-4 py-2">
      <button
        type="button"
        id="filter-year-floating-toggle"
        aria-pressed="false"
        aria-label="Reproduzir evolução dos anos"
        class="grid size-7 shrink-0 cursor-pointer place-items-center rounded-lg border border-gray-200 text-gray-600 transition-colors hover:bg-gray-100"
      >
        <span id="filter-year-floating-icon-play"><Play class="size-3" /></span>
        <span id="filter-year-floating-icon-pause" hidden
          ><Pause class="size-3" /></span
        >
      </button>
      <input
        type="range"
        id="filter-year-floating"
        aria-label="Ano"
        class="w-full accent-primary-500"
      />
      <output
        id="filter-year-floating-value"
        for="filter-year-floating"
        class="shrink-0 text-sm font-medium text-gray-600 tabular-nums"
        >2025</output
      >
      <button
        type="button"
        id="filters-floating-open"
        aria-label="Ver todos os filtros"
        class="chart-export-trigger shrink-0"
      >
        <SlidersHorizontal class="size-4" />
      </button>
    </div>
  </div>
</div>
