---
interface Props {
  label: string;
  valueId: string;
  unit?: string;
  subtitleId?: string;
}

const { label, valueId, unit, subtitleId } = Astro.props;
---

<div
  class="flex h-full flex-col justify-center gap-2 rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-700 dark:bg-gray-900"
>
  <p class="text-sm font-medium text-gray-600 dark:text-gray-400">{label}</p>
  <div class="flex flex-col gap-1">
    <p class="flex flex-wrap items-baseline gap-x-2">
      <span
        class="text-2xl font-bold text-gray-800 tabular-nums lg:text-3xl dark:text-gray-100"
        id={valueId}
      >
        —
      </span>
      {
        unit && (
          <span class="text-sm text-gray-500 dark:text-gray-400">{unit}</span>
        )
      }
    </p>
    {
      subtitleId && (
        <p
          class="text-sm text-gray-500 data-[direction=down]:text-emerald-600 data-[direction=up]:text-red-600 dark:data-[direction=down]:text-emerald-400 dark:data-[direction=up]:text-red-400"
          id={subtitleId}
        >
          &nbsp;
        </p>
      )
    }
  </div>
</div>
