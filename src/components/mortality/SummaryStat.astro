---
interface Props {
  label: string;
  valueId: string;
  subtitleId?: string;
}

const { label, valueId, subtitleId } = Astro.props;
---

<div
  class="flex h-full flex-col justify-center gap-1 rounded-2xl border border-gray-200 bg-white p-4"
>
  <p class="font-medium text-gray-600">{label}</p>
  <div class="flex flex-col gap-1 lg:flex-row lg:items-end">
    <p class="font-bold text-gray-800" id={valueId}>—</p>
    {
      subtitleId && (
        <p class="text-gray-500" id={subtitleId}>
          &nbsp;
        </p>
      )
    }
  </div>
</div>
