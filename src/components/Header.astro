---
import { Menu } from "@lucide/astro";

const navLinks = [
  { href: "#app-charts", label: "Dados" },
  { href: "#app-sobre", label: "Sobre" },
  { href: "#app-download", label: "Baixar" },
  { href: "#app-fontes", label: "Fontes" },
];
---

<div class="center w-full py-4">
  <header
    id="app-header"
    class="app-content items-center justify-between gap-4 px-4"
  >
    <a href="/" class="flex shrink-0 items-center gap-3">
      <img src="/logo.svg" alt="" width="40" height="40" class="w-10 sm:w-12" />
      <div class="flex flex-col gap-0 text-base *:leading-none sm:text-lg">
        <span>Causa</span>
        <span class="font-bold">Mortis</span>
      </div>
    </a>

    <nav aria-label="Navegação principal" class="hidden sm:block">
      <ul class="flex gap-6 text-base">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="transition-colors hover:text-primary-600"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <details class="relative sm:hidden">
      <summary
        class="chart-export-trigger"
        aria-label="Abrir menu de navegação"
      >
        <Menu class="size-5" />
      </summary>
      <div class="chart-export-menu right-0">
        {
          navLinks.map((link) => (
            <a href={link.href} class="chart-export-item">
              {link.label}
            </a>
          ))
        }
      </div>
    </details>
  </header>
</div>

<div
  id="app-header-mini"
  inert
  class="fixed inset-x-0 top-0 z-20 -translate-y-full border-b border-gray-200 bg-white/95 backdrop-blur-sm transition-transform duration-200 data-visible:translate-y-0"
>
  <div class="center w-full">
    <div class="app-content items-center justify-between gap-4 px-4 py-2">
      <a href="/" class="flex shrink-0 items-center gap-2">
        <img src="/logo.svg" alt="" width="28" height="28" class="w-7" />
        <span class="text-sm">Causa <span class="font-bold">Mortis</span></span>
      </a>

      <nav aria-label="Navegação principal" class="hidden sm:block">
        <ul class="flex gap-4 text-sm">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="transition-colors hover:text-primary-600"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <details class="relative sm:hidden">
        <summary
          class="chart-export-trigger"
          aria-label="Abrir menu de navegação"
        >
          <Menu class="size-4" />
        </summary>
        <div class="chart-export-menu right-0">
          {
            navLinks.map((link) => (
              <a href={link.href} class="chart-export-item">
                {link.label}
              </a>
            ))
          }
        </div>
      </details>
    </div>
  </div>
</div>

<script>
  const header = document.getElementById("app-header");
  const miniHeader = document.getElementById("app-header-mini");

  if (header && miniHeader) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        const visible = !entry.isIntersecting;
        miniHeader.toggleAttribute("data-visible", visible);
        miniHeader.inert = !visible;
      },
      { threshold: 0 },
    );
    observer.observe(header);
  }
</script>
