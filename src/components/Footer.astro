---
import GithubIcon from "./icons/GithubIcon.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { siteNavLinks } from "../lib/nav";

const year = new Date().getFullYear();
---

<div
  class="center w-full border-t border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-900"
>
  <footer class="app-content-col app-gutter gap-6 py-8 sm:py-10">
    <div class="flex flex-wrap items-center justify-between gap-6">
      <a href="/" class="flex items-center gap-3">
        <img src="/logo.svg" alt="" width="40" height="40" class="w-10" />
        <div class="flex flex-col gap-0 text-base *:leading-none">
          <span>Causa</span>
          <span class="font-bold">Mortis</span>
        </div>
      </a>

      <nav aria-label="Navegação do rodapé" class="flex flex-col gap-3">
        <ul
          class="flex flex-wrap items-center gap-6 text-sm text-gray-600 dark:text-gray-400"
        >
          {
            siteNavLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? "_blank" : undefined}
                  rel={link.external ? "noopener noreferrer" : undefined}
                  class="flex items-center gap-1.5 transition-colors hover:text-gray-900 dark:hover:text-gray-100"
                >
                  {link.icon === "github" && <GithubIcon class="size-4" />}
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            <ThemeToggle
              class="-my-2 text-gray-600 hover:bg-gray-100 focus-visible:outline-primary-500 dark:text-gray-400 dark:hover:bg-gray-800"
            />
          </li>
        </ul>
      </nav>
    </div>

    <p class="max-w-140 text-sm text-gray-600 dark:text-gray-400">
      Painel de infográficos sobre mortalidade no Brasil, construído a partir
      dos microdados do SIM/DATASUS e das projeções populacionais do IBGE.
      Finalidade didática e de divulgação.
    </p>

    <p class="text-xs text-gray-500 dark:text-gray-400">
      © {year} Causa Mortis. Projeto distribuído sob a licença MIT. O conteúdo pode
      ser compartilhado e reutilizado em trabalhos derivados, desde que a fonte seja
      citada.
    </p>
  </footer>
</div>
