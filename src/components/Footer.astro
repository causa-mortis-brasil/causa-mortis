---
import DesvendadosLogo from "./icons/DesvendadosLogo.astro";

const year = new Date().getFullYear();
---

<div
  class="center w-full border-t border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-900"
>
  <footer class="app-content-col app-gutter gap-6 py-8 sm:py-10">
    <div class="flex flex-wrap items-center justify-between gap-6">
      <a href="/">
        <span class="text-xl"
          ><span class="font-light text-gray-600 dark:text-gray-300">causa</span
          ><span
            class="text-[0.92em] font-extrabold text-gray-900 dark:text-white"
            >mortis</span
          ></span
        >
      </a>

      <div class="flex items-center gap-6">
        <a
          href="https://desvendados.com"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 text-sm text-gray-600 transition-colors hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100"
        >
          <span class="mt-0.5">Em parceria com</span>
          <DesvendadosLogo class="h-7 w-auto" />
        </a>
      </div>
    </div>

    <p class="max-w-140 text-sm text-gray-600 dark:text-gray-400">
      Painel de infográficos sobre mortalidade no Brasil. Finalidade didática e
      de divulgação.
    </p>

    <p class="text-xs text-gray-500 dark:text-gray-400">
      © {year} Causa Mortis. Projeto distribuído sob a licença MIT. O conteúdo pode
      ser compartilhado e reutilizado em trabalhos derivados, desde que a fonte seja
      citada.
    </p>
  </footer>
</div>
