---
import { LoaderCircle } from "@lucide/astro";
---

<div
  id="global-loader"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90 backdrop-blur-sm transition-opacity"
>
  <div class="flex flex-col items-center gap-3 rounded-full p-6">
    <LoaderCircle
      class="size-14 animate-spin text-blue-600 dark:text-blue-400"
    />
  </div>
</div>
