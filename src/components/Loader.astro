---
import { LoaderCircle } from "@lucide/astro";
---

<div
  id="global-loader"
  class="hidden fixed inset-0 z-50 items-center justify-center bg-black/90 backdrop-blur-sm transition-opacity"
>
  <div class="flex flex-col items-center gap-3 p-6 rounded-full">
    <LoaderCircle
      class="animate-spin text-blue-600 dark:text-blue-400 w-14 h-14"
    />
  </div>
</div>
